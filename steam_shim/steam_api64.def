; steam_api64.def — linker export-forwarding table for the DoomLauncher shim.
;
; MSVC .def syntax: every entry forwards <name> to <name> exported by
; steam_api64_o.dll (the original Valve DLL, renamed). The linker implements
; these as export forwarding records — the DLL contains no forwarding code of
; its own. NOTE: the `EXPORTS` header is REQUIRED (without it MSVC silently
; produces a DLL with zero exports — discovered the hard way).
;
; This list contains only symbol NAMES (facts about the Steamworks ABI), not
; Valve code, so it is safe to commit. It was generated from the DOOM rerelease
; engine's import table plus a verified presence check against Valve's shipped
; steam_api64.dll (a forward to a missing export would break module load).
;
; If an engine update changes the import table, regenerate with
; generate-exports.ps1 — symptom: the game fails to start with the shim
; installed and steam_shim.log shows nothing (the loader itself refuses to
; load the shim).

EXPORTS

; --- Steam API (all imported by the kex engine; extras verified present) ---
SteamAPI_Init=steam_api64_o.SteamAPI_Init
SteamAPI_RestartAppIfNecessary=steam_api64_o.SteamAPI_RestartAppIfNecessary
SteamAPI_RegisterCallback=steam_api64_o.SteamAPI_RegisterCallback
SteamAPI_UnregisterCallback=steam_api64_o.SteamAPI_UnregisterCallback
SteamAPI_RegisterCallResult=steam_api64_o.SteamAPI_RegisterCallResult
SteamAPI_UnregisterCallResult=steam_api64_o.SteamAPI_UnregisterCallResult
SteamAPI_RunCallbacks=steam_api64_o.SteamAPI_RunCallbacks
SteamAPI_Shutdown=steam_api64_o.SteamAPI_Shutdown
SteamAPI_GetHSteamUser=steam_api64_o.SteamAPI_GetHSteamUser
SteamAPI_IsSteamRunning=steam_api64_o.SteamAPI_IsSteamRunning
SteamAPI_ManualDispatch_Init=steam_api64_o.SteamAPI_ManualDispatch_Init
SteamAPI_ManualDispatch_RunFrame=steam_api64_o.SteamAPI_ManualDispatch_RunFrame
SteamInternal_ContextInit=steam_api64_o.SteamInternal_ContextInit
SteamInternal_FindOrCreateUserInterface=steam_api64_o.SteamInternal_FindOrCreateUserInterface

; --- Bare HSteam handles (legacy ABI, verified present) ---
GetHSteamUser=steam_api64_o.GetHSteamUser
GetHSteamPipe=steam_api64_o.GetHSteamPipe

; --- Game server API (verified present; harmless if unused) ---
SteamGameServer_Init=steam_api64_o.SteamGameServer_Init
SteamGameServer_Shutdown=steam_api64_o.SteamGameServer_Shutdown
SteamGameServer_RunCallbacks=steam_api64_o.SteamGameServer_RunCallbacks
